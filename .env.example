# Скопируй в .env и подставь значения

# Обязательно для текста слайдов (Gemini)
GEMINI_API_KEY=

# По желанию — лучший поиск фото (https://www.pexels.com/api/)
PEXELS_API_KEY=

# По желанию — запасной поиск (https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=

# Wikimedia Commons в приложении работает без ключа
